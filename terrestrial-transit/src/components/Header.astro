---
import Logo from './Logo.astro';
---

<header class="border-b border-hairline bg-canvas sticky top-0 z-50">
  <div class="mx-auto max-w-[1200px] px-4 sm:px-6 flex items-center justify-between h-14">
    <a href="/" class="flex items-center gap-2.5 text-ink font-semibold text-[14px] leading-5 tracking-[-0.28px] hover:opacity-80 transition-opacity">
      <Logo class="w-6 h-6 shrink-0" />
      <span>3D Model File Converter</span>
    </a>
    <nav class="flex items-center gap-4 sm:gap-6 text-[13px] font-medium text-mute">
      <a href="/" class="hover:text-ink transition-colors">Converter</a>
      <a href="/about" class="hover:text-ink transition-colors">About</a>
      <a href="/contact" class="hover:text-ink transition-colors">Contact</a>
    </nav>
  </div>
</header>
